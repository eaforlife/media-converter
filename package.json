{
  "name": "ea-media-tools",
  "productName": "EA Media Tools",
  "version": "1.1.0",
  "codename": "ea-video",
  "description": "A sleek desktop FFmpeg command builder and media transcoder.",
  "repository": {
    "type": "git",
    "url": "https://github.com/eaforlife/media-converter.git"
  },
  "main": ".vite/build/main.js",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:wix": "node scripts/make-wix.mjs",
    "publish": "electron-forge publish",
    "lint": "eslint \"**/*.{ts,mts}\"",
    "typecheck": "tsc --noEmit",
    "typecheck:compat": "tsc6 --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/video-output-profile.test.ts src/app-update.test.ts src/closed-caption.test.ts src/encode-progress-state.test.ts src/ffmpeg-command-display.test.ts src/metadata-edit.test.ts src/metadata-replacement.test.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version"
  },
  "keywords": [],
  "author": {
    "name": "eaforlife",
    "email": "ea.0691@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-wix": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "electron": "^43.4.1",
    "eslint": "^10.8.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.11.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "update-electron-app": "^3.3.0"
  },
  "allowScripts": {
    "@bitdisaster/exe-icon-extractor": true,
    "electron-winstaller": true,
    "esbuild": true,
    "unrs-resolver": true
  }
}
